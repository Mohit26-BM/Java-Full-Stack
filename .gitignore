
# ==============================
# Keep the root README
# ==============================
!README.md

# Ignore all Markdown files
*.md

# Allow the root README.md only
!/README.md

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter Notebook
.ipynb_checkpoints/

# ==============================
# IDEs and editors
# ==============================
.vscode/
.idea/
*.iml
*.swp
*.swo

# ==============================
# OS files
# ==============================
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Logs and temporary files
# ==============================
*.log
*.tmp
*.temp
*.bak
*.orig
*.cache

# ==============================
# Node.js (if applicable)
# ==============================
node_modules/
npm-debug.log*
yarn-debug.log*

# ==============================
# Java / Maven build output
# (re-created by every build - never commit)
# ==============================
target/
bin/
out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
logs/
# Maven wrapper: keep mvnw / mvnw.cmd / maven-wrapper.properties, ignore the downloaded jar
.mvn/wrapper/maven-wrapper.jar

# ==============================
# Eclipse / Spring Tool Suite
# (every project has a pom.xml: re-import with
#  File > Import > Maven > Existing Maven Projects)
# ==============================
.metadata/
.recommenders/
.settings/
.classpath
.project
.factorypath
.apt_generated/
.apt_generated_tests/
.springBeans
.sts4-cache/
.loadpath
*.launch

# IntelliJ / NetBeans extras
*.iws
*.ipr
nbproject/private/

# ==============================
# Front-end build output (React / Vite)
# ==============================
dist-ssr/
*.local

# ==============================
# Local secrets (database passwords, JWT keys)
# ==============================
db.properties
db-secret.properties
secrets.properties

# ==============================
# Heavy binaries, installers and archives
# (e.g. gitlab-runner-windows-amd64.exe is ~137 MB)
# ==============================
*.exe
*.msi
*.dll
*.zip
*.rar
*.7z
*.tar
*.gz
*.tgz
*.iso
*.dmg
*.bin

# Local databases (H2 / SQLite) and Docker image exports
*.mv.db
*.trace.db
*.sqlite
*.sqlite3
*.db

# Build caches
.metals/
.bloop/
.gradle/
.next/
.vite/
*.tsbuildinfo
